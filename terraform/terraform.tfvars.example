# Copia este archivo como terraform.tfvars y ajusta los valores.
# Caso de prueba 4: un solo `terraform apply` despliega todo el stack.

aws_region  = "us-east-1"
project     = "cloudshop"
stage_name  = "dev"

# Correo que usarás como remitente SES (recibirás un mail de verificación)
ses_sender_email  = "tu-correo@ejemplo.com"
ses_verify_sender = true

jwt_expiration_hours = 24
log_retention_days   = 14

upload_frontend      = true
waf_rate_limit       = 2000
enable_event_archive = true

# --- Report Service / CloudWatch (Módulo 6 / Caso 3) ---
report_latency_alarm_ms           = 3000
enable_api_gateway_method_metrics = true
